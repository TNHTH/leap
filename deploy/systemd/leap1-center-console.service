[Unit]
Description=Leap A20 Center Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__LEAP_USER__
Group=__LEAP_USER__
WorkingDirectory=/home/__LEAP_USER__/leap/ros2_ws
Environment=HOME=/home/__LEAP_USER__
Environment=LEAP1_A20_RUNTIME_ROOT=/home/__LEAP_USER__/leap/runtime/a20
Environment=LEAP1_A20_WEB_PORT=8090
Environment=LEAP1_PANEL_MODE=status_only
Environment=LEAP1_EXPECTED_VEHICLE_CAMERA=true
Environment=LEAP1_WITH_GROUND_CAMERA=true
Environment=LEAP1_GROUND_CAMERA_DEVICE=
ExecStart=/home/__LEAP_USER__/leap/ros2_ws/src/leap1/tools/run_leap1_center_console.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
