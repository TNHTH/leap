[Unit]
Description=Leap A20 Status Web Panel
After=network-online.target
Wants=network-online.target
Conflicts=leap1-a20.service

[Service]
Type=simple
User=__LEAP_USER__
Group=__LEAP_USER__
WorkingDirectory=/home/__LEAP_USER__/leap/ros2_ws
Environment=HOME=/home/__LEAP_USER__
Environment=LEAP1_A20_RUNTIME_ROOT=/home/__LEAP_USER__/leap/runtime/a20
Environment=LEAP1_A20_WEB_PORT=8090
Environment=LEAP1_PANEL_MODE=status_only
Environment=LEAP1_REQUIRE_ODOM=false
Environment=LEAP1_REQUIRE_VEHICLE_CAMERA=false
Environment=LEAP1_WITH_WEB_PANEL=true
Environment=LEAP1_WITH_VEHICLE_CAMERA=true
Environment=LEAP1_WITH_GROUND_CAMERA=false
Environment=LEAP1_VEHICLE_CAMERA_DEVICE=/dev/video0
ExecStart=/home/__LEAP_USER__/leap/ros2_ws/src/leap1/tools/run_leap1_a20_status_web.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
