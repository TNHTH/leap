[Unit]
Description=Leap A20 Vehicle Stack
After=network-online.target leap1-microros-agent.service
Wants=network-online.target leap1-microros-agent.service
Conflicts=leap1-a20-status-web.service

[Service]
Type=simple
User=__LEAP_USER__
Group=__LEAP_USER__
WorkingDirectory=/home/__LEAP_USER__/leap/ros2_ws
Environment=HOME=/home/__LEAP_USER__
Environment=LEAP1_AGENT_TRANSPORT=external_serial
Environment=LEAP1_AGENT_SERIAL_DEV=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
Environment=LEAP1_AGENT_SERIAL_BAUD=921600
Environment=LEAP1_WITH_A20_STACK=true
Environment=LEAP1_WITH_WEB_TELEOP=true
Environment=LEAP1_WITH_VEHICLE_CAMERA=true
Environment=LEAP1_WITH_GROUND_CAMERA=false
Environment=LEAP1_VEHICLE_CAMERA_DEVICE=/dev/video0
Environment=LEAP1_A20_WEB_PORT=8090
Environment=LEAP1_A20_RUNTIME_ROOT=/home/__LEAP_USER__/leap/runtime/a20
ExecStart=/home/__LEAP_USER__/leap/ros2_ws/src/leap1/tools/run_leap1_a20_vehicle.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
